# ============================================================================
# 归一化输入清单（Source Manifest）模板
# ============================================================================
# 将此文件复制到工作空间的 raw/source_manifest.yaml 并根据实际情况修改。
#
# 使用方式：
#   python scripts/workspace/run_ingest.py --workspace <workspace_name>
#   python scripts/workspace/init_workspace.py --source-type <type>
# ============================================================================

# --------------------------------------------------------------------------
# [必填] 来源类型标识
# 可选值：wechat_html | telegram_json | whatsapp_txt | generic_csv | generic_jsonl
# --------------------------------------------------------------------------
source_type: wechat_html

# --------------------------------------------------------------------------
# [必填] 输入文件或目录路径列表
# 支持绝对路径或相对于工作空间 raw/ 目录的相对路径
# --------------------------------------------------------------------------
input_paths:
  - ./export.html          # 微信: HTML 导出文件
  # - ./result.json        # Telegram: JSON 导出文件
  # - ./chat.txt           # WhatsApp: TXT 导出文件
  # - ./data.csv           # 通用 CSV 文件

# --------------------------------------------------------------------------
# [可选] 参与者名称到 speaker 值的映射
# speaker 取值：ME（自己）、OTHER（对方）、OTHER:{名称}（群聊中的其他人）
# --------------------------------------------------------------------------
participant_map:
  # "我的名字": "ME"
  # "对方名字": "OTHER"
  # "群友A": "OTHER:群友A"

# --------------------------------------------------------------------------
# [可选] 时区标识（默认 Asia/Shanghai）
# 用于将本地时间转换为 Unix 时间戳
# --------------------------------------------------------------------------
timezone: Asia/Shanghai

# --------------------------------------------------------------------------
# [可选] 媒体文件基础目录
# 适配器会在此目录下查找消息引用的媒体文件
# 默认为输入文件所在目录
# --------------------------------------------------------------------------
# media_base_dir: ./media

# --------------------------------------------------------------------------
# [可选] 工作空间名称
# 用于生成导出文件的文件名前缀
# --------------------------------------------------------------------------
# workspace_name: my_chat

# --------------------------------------------------------------------------
# [可选] 字段映射（仅 generic_csv / generic_jsonl 适配器使用）
# 语法：
#   source_field: target_field          # 直接映射
#   _const:value: target_field          # 常量值（所有记录使用此值）
#   _default:value: target_field        # 默认值（仅源字段缺失时使用）
# --------------------------------------------------------------------------
# field_mapping:
#   timestamp: ts
#   sender_name: speaker
#   content: text_raw
#   msg_type: type
#   _const:text: modality
#   _const:GEN: _source_prefix
#   _default:0: sub_type
